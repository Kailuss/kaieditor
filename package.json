{
  "name": "kaieditor",
  "displayName": "KaiEditor",
  "description": "Turns code comments into styled visual blocks directly inside the editor, without changing the source code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.2"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kaieditor.helloWorld",
        "title": "KaiEditor: Hello World"
      },
      {
        "command": "kaieditor.toggle",
        "title": "KaiEditor: Toggle Comment Boxes"
      },
      {
        "command": "kaieditor.refresh",
        "title": "KaiEditor: Refresh Decorations"
      }
    ],
    "configuration": {
      "title": "KaiEditor",
      "properties": {
        "kaieditor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable KaiEditor comment box transformations"
        },
        "kaieditor.enabledLanguages": {
          "type": "array",
          "default": ["javascript", "typescript", "python", "rust", "go"],
          "description": "List of languages where comment boxes will be shown",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "close-dev-host": "node ./scripts/close-dev-host.js",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
