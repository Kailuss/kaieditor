{
  "name": "kaieditor",
  "displayName": "KaiEditor",
  "description": "Turns code comments into styled visual blocks directly inside the editor, without changing the source code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.2"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kaieditor.helloWorld",
        "title": "KaiEditor: Hello World"
      },
      {
        "command": "kaieditor.toggle",
        "title": "KaiEditor: Toggle Comment Boxes"
      },
      {
        "command": "kaieditor.refresh",
        "title": "KaiEditor: Refresh Decorations"
      }
    ],
    "configuration": {
      "title": "KaiEditor",
      "properties": {
        "kaieditor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable KaiEditor comment box transformations"
        },
        "kaieditor.enabledLanguages": {
          "type": "array",
          "default": ["javascript", "typescript", "python", "rust", "go"],
          "description": "List of languages where comment boxes will be shown",
          "items": {
            "type": "string"
          }
        },
        "kaieditor.backgroundColor": {
          "type": "string",
          "default": "#2e3440",
          "description": "Background color for comment boxes"
        },
        "kaieditor.textColor": {
          "type": "string",
          "default": "#eceff4",
          "description": "Text color for comment boxes"
        },
        "kaieditor.borderColor": {
          "type": "string",
          "default": "#4c566a",
          "description": "Border color for comment boxes"
        },
        "kaieditor.accentColor": {
          "type": "string",
          "default": "#88c0d0",
          "description": "Accent color for block comment left border"
        },
        "kaieditor.borderRadius": {
          "type": "number",
          "default": 16,
          "minimum": 0,
          "maximum": 20,
          "description": "Border radius in pixels"
        },
        "kaieditor.paddingVertical": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "Vertical padding in pixels"
        },
        "kaieditor.paddingHorizontal": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 40,
          "description": "Horizontal padding in pixels"
        },
        "kaieditor.fontStyle": {
          "type": "string",
          "enum": ["normal", "italic"],
          "default": "normal",
          "description": "Font style for comment text"
        },
        "kaieditor.fontWeight": {
          "type": "string",
          "enum": ["400", "500", "600"],
          "default": "400",
          "description": "Font weight for comment text"
        },
        "kaieditor.opacity": {
          "type": "number",
          "default": 0.95,
          "minimum": 0.1,
          "maximum": 1.0,
          "description": "Opacity level for comment boxes"
        },
        "kaieditor.inlineFontSize": {
          "type": "string",
          "default": "0.64em",
          "description": "Font size for inline comments (e.g., '0.64em', '12px')"
        },
        "kaieditor.inlinePaddingTop": {
          "type": "string",
          "default": "1px",
          "description": "Top padding for inline comments"
        },
        "kaieditor.inlinePaddingBottom": {
          "type": "string",
          "default": "0.5px",
          "description": "Bottom padding for inline comments"
        },
        "kaieditor.blockFontSize": {
          "type": "string",
          "default": "0.9em",
          "description": "Font size for block comments (e.g., '0.9em', '14px')"
        },
        "kaieditor.blockPaddingMultiplier": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "Multiplier for vertical padding in block comments"
        },
        "kaieditor.tagColors.important": {
          "type": "string",
          "default": "#ff6b6b99",
          "description": "Background color for //! important tags"
        },
        "kaieditor.tagColors.success": {
          "type": "string",
          "default": "#49c78a99",
          "description": "Background color for //· success tags"
        },
        "kaieditor.tagColors.warning": {
          "type": "string",
          "default": "#ffb86b99",
          "description": "Background color for //? warning tags"
        },
        "kaieditor.tagColors.info": {
          "type": "string",
          "default": "#74b3ff99",
          "description": "Background color for //@ info tags"
        },
        "kaieditor.tagColors.debug": {
          "type": "string",
          "default": "#b084ff99",
          "description": "Background color for //# debug tags"
        },
        "kaieditor.docColors.backgroundColor": {
          "type": "string",
          "default": "#061425",
          "description": "Background color for documentation comments (JSDoc, etc.)"
        },
        "kaieditor.docColors.borderColor": {
          "type": "string",
          "default": "#1b2b3a",
          "description": "Border color for documentation comments"
        },
        "kaieditor.docColors.textColor": {
          "type": "string",
          "default": "#bcd6ee",
          "description": "Text color for documentation comments"
        },
        "kaieditor.showIcons": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar iconos SVG antes del texto de comentarios con tags personalizados (!,·,?,@,#)"
        },
        "kaieditor.iconSize": {
          "type": "number",
          "default": 12,
          "minimum": 10,
          "maximum": 18,
          "description": "Tamaño de los iconos en píxeles (afecta también al padding del fondo para integrarlos)"
        },
        "kaieditor.iconMargin": {
          "type": "string",
          "default": "0 4px 0 0",
          "description": "Margen de los iconos (formato CSS: top right bottom left)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "close-dev-host": "node ./scripts/close-dev-host.js",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
